# Aether environment variable inventory.
# Railway can suggest these names from this file, but you must import them
# in the Railway Variables tab and provide real values for enabled services.
# Keep secrets blank here; never commit live credentials.

# Market data providers (optional; configure only providers you use)
TWELVEDATA_API_KEY=
FINNHUB_API_KEY=
ALPHAVANTAGE_API_KEY=
OANDA_API_KEY=
OANDA_ACCOUNT_ID=

# Telegram (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Discord and generic webhook delivery (optional)
DISCORD_WEBHOOK_URL=
WEB_ENDPOINT_URL=

# WhatsApp (optional). WHATSAPP_AUTH_TOKEN is used by the onboarding-generated
# config; TWILIO_AUTH_TOKEN is retained for existing config installations.
WHATSAPP_AUTH_TOKEN=
TWILIO_AUTH_TOKEN=
WHATSAPP_PHONE_NUMBER=

# Cloud LLM providers (optional; set the key for your selected provider)
NVIDIA_API_KEY=
OPENAI_API_KEY=
CLAUDE_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=

# Optional model overrides for cloud LLM providers
NVIDIA_MODEL=
OPENAI_MODEL=
CLAUDE_MODEL=
GEMINI_MODEL=
OPENROUTER_MODEL=

# Ollama (optional; defaults to the configured local URL)
OLLAMA_BASE_URL=http://127.0.0.1:11434
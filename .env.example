# Aether - Environment Variables
# Copy this file to .env and fill in your values

# Admin API token (required for /start, /stop, /reload endpoints)
AETHER_ADMIN_TOKEN=your-secure-random-token-here

# Telegram (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# TELEGRAM_WEBHOOK_SECRET=  # auto-generated if not set

# Discord (optional)
DISCORD_WEBHOOK_URL=

# Webhook delivery (optional)
WEB_ENDPOINT_URL=

# WhatsApp (optional)
TWILIO_AUTH_TOKEN=
WHATSAPP_PHONE_NUMBER=

# Ollama (local LLM)
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Model configuration (for cloud providers - optional)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=